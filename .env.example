# AURA API / Browser provider credentials
PORT=8787
NODE_ENV=development

# Keep provider credentials local. Never expose them through WXT_* variables.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# AURA Browser event defaults. The local model is the fast structural path;
# OpenAI remains the deeper semantic refinement path.
AURA_PAGE_REASONING_EFFORT=medium
AURA_OLLAMA_URL=http://127.0.0.1:11434
AURA_LOCAL_MODEL=qwen3.5:4b-mlx
AURA_LOCAL_CONTEXT=8192
AURA_LOCAL_CONVERSATION=1
AURA_CONVERSATION_PROVIDER=cloud
AURA_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Legacy API/extension speech configuration.
STT_PROVIDER=mock
STT_API_KEY=
STT_MODEL=gpt-4o-mini-transcribe

# Comma-separated exact origins. Add the unpacked extension origin for live API calls.
AURA_ALLOWED_ORIGINS=http://localhost:3000

# Public configuration: this is an endpoint only, never a secret.
WXT_PUBLIC_AURA_API_BASE_URL=http://localhost:8787
